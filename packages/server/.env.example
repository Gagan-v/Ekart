PORT=5001
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/ekart
# Generate a random secret; never commit your real .env.
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000
# Production behind one trusted reverse proxy: TRUST_PROXY_HOPS=1
AWS_REGION=us-east-2
AWS_S3_BUCKET=ekart-mobiles
# Prefer an IAM role in production. Set these only for local development.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
